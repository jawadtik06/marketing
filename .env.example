# Copy this file to .env and fill in your values
PORT=3000
BASE_URL=http://localhost:3000
# Long random text used to sign download links
DOWNLOAD_SECRET=change-this-to-a-long-random-string
# Admin dashboard at /admin (user: admin)
ADMIN_PASSWORD=choose-a-strong-password
# Stripe card payments (leave empty to save card orders as pending)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Email (leave SMTP_HOST empty to print emails in the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=3Dway <orders@yourdomain.com>
